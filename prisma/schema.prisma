// FirstFund Prisma schema
// Full data model for paper trading platform

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────── Users & Settings ───────────────────
model User {
  id              Int               @id @default(autoincrement())
  email           String            @unique
  username        String?           @unique
  passwordHash    String
  portfolio       Portfolio?
  settings        UserSettings?
  watchlists      Watchlist[]
  priceAlerts     PriceAlert[]
  trades          Trade[]
  portfolioSnapshots PortfolioSnapshot[]
  budget          Budget?
  lessonProgress  UserLessonProgress[]
  missions        UserMission[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt
}

model UserSettings {
  id              Int               @id @default(autoincrement())
  userId          Int               @unique
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme           String            @default("dark")    // "dark", "light", "system"
  currency        String            @default("USD")
  chartStyle      String            @default("line")    // "line", "candle"
  leaderboardOptIn Boolean          @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt
}

// ─────────────────── Portfolio & Trading ───────────────────
model Portfolio {
  id              Int               @id @default(autoincrement())
  userId          Int               @unique
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  cash            Float             @default(10000)
  positions       Position[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt
}

model Position {
  id              Int               @id @default(autoincrement())
  portfolioId     Int
  portfolio       Portfolio         @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  symbol          String            // Stock symbol (e.g. "AAPL")
  shares          Float             // Changed from Int to Float for fractional shares
  avgCost         Float             // Average cost per share
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt

  @@unique([portfolioId, symbol])
}

model Trade {
  id              Int               @id @default(autoincrement())
  userId          Int
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol          String
  side            String            // "BUY" or "SELL"
  shares          Float             // Changed from Int to Float for fractional shares
  price           Float             // Price per share
  total           Float             // Total cost (shares * price)
  realizedPL      Float?            // Realized profit/loss (for SELL trades)
  sellReason      String?           // For trade journaling
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt

  @@index([userId])
}

// ─────────────────── Learning Hub ───────────────────
model UserLessonProgress {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String    // e.g. "1.1", "2.3", "4.4"
  completed   Boolean   @default(false)
  passed      Boolean   @default(false)  // quiz passed
  quizScore   Int?      // e.g. 2 out of 3
  rewardGiven Boolean   @default(false)  // prevent double-reward
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
}

model UserMission {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionId   String    // e.g. "mission_watchlist_3", "mission_alert_aapl"
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@unique([userId, missionId])
  @@index([userId])
}

model PortfolioSnapshot {
  id              Int               @id @default(autoincrement())
  userId          Int
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalValue      Float             // Portfolio total value at snapshot time
  snapshotDate    DateTime          @default(now())

  @@index([userId, snapshotDate])
}

// ─────────────────── Watchlists ───────────────────
model Watchlist {
  id              Int               @id @default(autoincrement())
  userId          Int
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  symbols         String[]          // Array of stock symbols
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt

  @@unique([userId, name])
}

// ─────────────────── Price Alerts ───────────────────
model PriceAlert {
  id              Int               @id @default(autoincrement())
  userId          Int
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol          String
  targetPrice     Float
  direction       String            // "ABOVE" or "BELOW"
  triggered       Boolean           @default(false)
  triggeredAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt

  @@index([userId])
}

// ─────────────────── Budget & Allocations ───────────────────
model Budget {
  id              Int               @id @default(autoincrement())
  userId          Int               @unique
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  allocations     Allocation[]
  symbolCategoryMap Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt
}

model Allocation {
  id              Int               @id @default(autoincrement())
  budgetId        Int
  budget          Budget            @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category        String            // "Tech", "Healthcare", "ETF", "Cash Reserve", etc.
  targetPct       Float             // Target percentage (e.g. 40.0)
  color           String            @default("#3b82f6")  // For chart rendering
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt

  @@unique([budgetId, category])
}

// ─────────────────── Stock (Legacy - for reference) ───────────────────
// Keep for backward compatibility with existing data, but not used in new code
model Stock {
  id        Int    @id @default(autoincrement())
  Date      String
  CloseLast String
  Volume    String
  Open      String
  High      String
  Low       String
}
