# Core Database URL
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# Auth Security
JWT_SECRET="your_super_secret_jwt_key_here"

# App Environment
NODE_ENV="development"

# API Keys (optional, but recommended for stock data coverage)
FINNHUB_API_KEY="finnhub_api_key_here"
MASSIVE_API_KEY="your_massive_api_key_here"

# Server Configuration
PORT=3001
CACHE_TTL_SECONDS=60
CACHE_STALE_TTL_SECONDS=86400
GENERAL_RATE_LIMIT_WINDOW_MS=900000
GENERAL_RATE_LIMIT_MAX=1000
MASSIVE_MAX_CALLS_PER_MIN=5
ELECTRON_START_URL="http://localhost:5173"
